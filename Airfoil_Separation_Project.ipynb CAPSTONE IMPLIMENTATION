        "\n",
        "# Step 8: Calculate signed tangential wall shear stress\n",
        "\n",
        "# Get wall shear stress vectors\n",
        "wss = simulation.wallshearstress(\n",
        "    over_airfoil=True,\n",
        "    reference=True\n",
        ")\n",
        "\n",
        "# Get airfoil surface normals\n",
        "normals = simulation.airfoil_normals\n",
        "\n",
        "# Get incoming airflow direction\n",
        "flow = np.array([\n",
        "    np.cos(simulation.angle_of_attack),\n",
        "    np.sin(simulation.angle_of_attack)\n",
        "])\n",
        "\n",
        "# Project airflow direction onto the airfoil surface\n",
        "tangent = flow - np.sum(flow * normals, axis=1)[:, None] * normals\n",
        "\n",
        "# Normalize tangent vectors\n",
        "tangent = tangent / (np.linalg.norm(\n",
        "    tangent, axis=1, keepdims=True\n",
        ") + 1e-12)\n",
        "\n",
        "# Calculate signed tangential shear stress\n",
        "signed_wss = np.sum(wss * tangent, axis=1)\n",
        "\n",
        "print(\"Signed wall shear stress calculated!\")\n",
        "print(\"Surface points:\", len(signed_wss))\n",
        "print(\"Minimum value:\", signed_wss.min())\n",
        "print(\"Maximum value:\", signed_wss.max())\n",
        "\n",
        "# Plot results\n",
        "plt.figure(figsize=(10, 5))\n",
        "plt.scatter(\n",
        "    simulation.airfoil_position[:, 0],\n",
        "    signed_wss,\n",
        "    s=5\n",
        ")\n",
        "\n",
        "plt.axhline(0, color='red', linestyle='--')\n",
        "plt.xlabel(\"Airfoil X Position\")\n",
        "plt.ylabel(\"Signed Tangential Wall Shear Stress\")\n",
        "plt.title(\"Signed Wall Shear Stress Distribution\")\n",
        "plt.grid()\n",
        "plt.show()\n"
